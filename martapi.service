[Unit]
Description=Martapi
After=local-fs.target systemd-user-sessions.service sound.target
Conflicts=getty@tty1.service

[Service]
Type=simple
WorkingDirectory=@REPO_DIR@
ExecStart=/usr/bin/python3 @REPO_DIR@/main.py
Environment=FB_DEVICE=/dev/fb1
Environment=SLIDE_SECONDS=10
Environment=AUDIO_DEVICE=plughw:Headphones
Environment=AUDIO_VOLUME=100%
EnvironmentFile=-/etc/martapi.env
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
